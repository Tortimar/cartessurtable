# Base de données : fichier SQLite local par défaut.
# Production : une base Turso (libsql://...) + DATABASE_AUTH_TOKEN fonctionne sans changer le code.
DATABASE_URL="file:./unboxipe.db"
# DATABASE_AUTH_TOKEN=""

# Secret de signature des sessions — à changer en production (32+ caractères aléatoires)
SESSION_SECRET="change-moi-par-une-longue-chaine-aleatoire-32+"

# Import Open Food Facts : pages de résultats (100 produits/page, triés par nombre de scans).
# Plages acceptées (« 1-10 »). Mélanger pages hautes et basses donne un vrai éventail de raretés.
# L'API limite à ~10 requêtes/minute : compter environ 7 s par page.
OFF_SEED_PAGES="1-10,20,30,60,120"
OFF_COUNTRY="france"
